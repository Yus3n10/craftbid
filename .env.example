# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# cp .env.example .env

# ─────────────────────────────────────────────────────────────
# Database — local development (docker compose up -d)
# ─────────────────────────────────────────────────────────────
ORACLE_USER=craftbid
ORACLE_PASSWORD=devpw_local
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1
ORACLE_SYS_PASSWORD=devsyspw_local

# ─────────────────────────────────────────────────────────────
# Database — Oracle Autonomous Database (production)
# ─────────────────────────────────────────────────────────────
# Leave ORACLE_WALLET_DIR empty for local dev. To target an Autonomous
# Database, download its wallet from the OCI console, unzip it OUTSIDE this
# repo, and point at that directory.
#
# node-oracledb thin mode needs the PEM wallet (ewallet.pem), NOT cwallet.sso.
# If your wallet zip lacks ewallet.pem, re-download it and choose the option
# that includes it.
#
# ORACLE_CONNECT_STRING then becomes a TNS alias from tnsnames.ora,
# e.g. myadb_tp
#
# ORACLE_WALLET_DIR=/absolute/path/outside/this/repo/wallet
# ORACLE_WALLET_PASSWORD=

# ─────────────────────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-value
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173,http://localhost:5181,tauri://localhost,http://tauri.localhost

# ─────────────────────────────────────────────────────────────
# Image storage
# ─────────────────────────────────────────────────────────────
# "local"    — writes to .storage/ and serves from the API. Development only:
#              Render's filesystem is ephemeral and is wiped on every deploy.
# "imagekit" — recommended for production. Free tier, no credit card.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/media

# ImageKit (https://imagekit.io) — required when STORAGE_DRIVER=imagekit
# IMAGEKIT_PUBLIC_KEY=
# IMAGEKIT_PRIVATE_KEY=
# IMAGEKIT_URL_ENDPOINT=

# ─────────────────────────────────────────────────────────────
# Email (verification links)
# ─────────────────────────────────────────────────────────────
# "none":   no email; email verification is switched off entirely.
# "log":    prints each email, link included, to the API console. Development.
# "outbox": writes each email to apps/api/.outbox/. Used by the browser tests.
# "brevo":  sends through Brevo's API. Production. Needs the two below.
MAIL_DRIVER=none
# BREVO_API_KEY=
# MAIL_FROM_EMAIL=
# MAIL_FROM_NAME=Craftbid
# Where links in emails point (the web app, not the API).
PUBLIC_WEB_URL=http://localhost:5173

# Production only. The same 32+ character value as the site Worker's
# PROXY_SHARED_SECRET; lets rate limits tell visitors apart behind the Worker.
# PROXY_SHARED_SECRET=

# ─────────────────────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000
