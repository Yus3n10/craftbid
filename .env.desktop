# Build-time config for the desktop app: `vite build --mode desktop`.
#
# Committed on purpose. It holds no secrets, only the public API address and
# the auth mode, and the desktop build must be reproducible in CI where no
# local .env exists.
#
# Point VITE_API_URL at your deployed API before tagging a release, otherwise
# the installed app will look for an API on localhost and find nothing.
VITE_API_URL=https://raxtan-api.onrender.com

# Cookies cannot work from tauri://localhost without weakening SameSite on the
# web app too, so the desktop build carries bearer tokens instead.
VITE_AUTH_MODE=bearer
