{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  // Tests and their helpers are run by Vitest, which transpiles them itself.
  // Keeping them out of the build means no test scaffolding ships to
  // production. They are still typechecked, via tsconfig.typecheck.json.
  "exclude": ["src/**/*.test.ts", "src/test/**", "dist"]
}
